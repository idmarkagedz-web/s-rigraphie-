{
 "name": "serigraphie-comptes",
 "version": "1.0.0",
 "description": "Gestion des comptes - atelier de serigraphie",
 "main": "main.js",
 "author": "Atelier",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win --publish never"
 },
 "devDependencies": {
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.atelier.serigraphie",
  "productName": "SerigraphieComptes",
  "files": [
   "main.js",
   "index.html",
   "build/icon.png"
  ],
  "directories": {
   "output": "dist"
  },
  "win": {
   "target": [
    "nsis",
    "portable"
   ],
   "icon": "build/icon.png"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true
  }
 }
}